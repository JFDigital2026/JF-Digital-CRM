# ─── Database ─────────────────────────────────────────────────────────────────
# Railway auto-injects this when you link a PostgreSQL plugin to your service.
# For local dev: postgresql://<user>@localhost:5432/<dbname>
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
# Production URL of your Railway deployment (no trailing slash)
NEXTAUTH_URL=https://your-app.up.railway.app

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret for scheduled endpoints (/api/cron/reminders and
# /api/automations/process-queue). The scheduler must send:
#   Authorization: Bearer <CRON_SECRET>
# Without it these endpoints reject all requests (fail closed). Generate: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Signing secret for the inbound-email webhook (Resend → Svix). Required for
# /api/webhooks/resend to accept requests. Format: whsec_...
RESEND_WEBHOOK_SECRET=whsec_...

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Zoom ─────────────────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...

# ─── Notifications ────────────────────────────────────────────────────────────
# Email address to receive new booking notifications
NOTIFY_EMAIL=you@example.com

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Private directory for uploaded files (served only via the authenticated
# download route, never statically). Defaults to <project>/uploads. On Railway,
# point this at a mounted volume so files survive redeploys.
# UPLOAD_DIR=/data/uploads

# ─── Optional ─────────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Railway to "production"
# PORT is injected automatically by Railway

# Trusted internal webhook targets (SSRF allowlist). Dev only. Unset in prod.
WEBHOOK_ALLOWED_LOCAL_HOSTS=localhost:5678
